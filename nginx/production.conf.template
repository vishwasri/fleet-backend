server {
    listen 80;
    server_name __FLEET_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __FLEET_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__FLEET_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__FLEET_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    resolver 127.0.0.11 valid=10s ipv6=off;
    client_max_body_size 25M;

    # 1. NestJS Backend API & Swagger Documentation
    location /api/ {
        set $fleet_api_upstream http://api:3000;
        proxy_pass $fleet_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    # 2. Next.js Static Chunks & Build Cache
    location /_next/ {
        set $fleet_web_upstream http://web:3000;
        proxy_pass $fleet_web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # 3. Next.js Web Application Frontend
    location / {
        set $fleet_web_upstream http://web:3000;
        proxy_pass $fleet_web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
